# Copie este arquivo para ".env" e preencha com a sua chave real.
# Obtenha a chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# --- Opcionais ---------------------------------------------------------
# Vazio = usa o modelo Flash estável mais novo liberado para a chave.
GEMINI_MODEL=

# Requisições por minuto. Sem faturamento no Google Cloud (nível gratuito), mantenha ~10.
# Com faturamento ativo (Tier 1+), pode subir para 300 ou mais.
GEMINI_RPM=10

# PDFs analisados em paralelo.
GEMINI_WORKERS=4

# Quantas páginas iniciais de cada PDF vão para a IA (capa, rosto, ficha, resumo).
PDF_PAGINAS=5

# Campos: {area} {sobrenome} {ano} {titulo} {tipo}
MODELO_NOME={area}-{sobrenome}-{ano}-{titulo}
