# Copie este arquivo para ".env", nesta mesma pasta (config), e preencha com a sua chave.
# O Iniciar.bat faz essa cópia sozinho na primeira vez.
# Obtenha a chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# --- Opcionais ---------------------------------------------------------
# Vazio = usa o modelo Flash estável mais novo liberado para a chave.
GEMINI_MODEL=

# Requisições por minuto. Sem faturamento no Google Cloud (nível gratuito), mantenha ~10.
# Com faturamento ativo (Tier 1+), pode subir para 300 ou mais.
GEMINI_RPM=10

# PDFs analisados em paralelo.
GEMINI_WORKERS=4

# Posição inicial do controle "Esforço da IA": 0 Econômico, 1 Normal, 2 Caprichado, 3 Máximo.
NIVEL_IA=1

# Campos: {area} {sobrenome} {ano} {titulo} {tipo}
MODELO_NOME={area}-{sobrenome}-{ano}-{titulo}

# Python usado pelo Iniciar.bat. Vazio = automático: o portátil (.python_embed), se
# existir; senão, o instalado. Dá para trocar pelo menu Configurações → Python…
PYTHON=
