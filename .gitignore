# ------------------------------------------------------------------
# Segredos: a chave da API mora em config/.env e nunca pode ir para o GitHub.
# O config/.env.example (modelo sem chave) é a exceção e deve ser versionado.
# ------------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------------
# Dados pessoais: os PDFs analisados e as cópias geradas são seus,
# não do projeto (e muitos têm direitos autorais de terceiros).
# ------------------------------------------------------------------
PDFs/
out/
*.pdf

# Cache das análises (SQLite) e memória do último modelo usado.
.cache/

# Diário do programa: tem nomes de arquivos e pastas desta máquina.
logs/

# Categorias e áreas personalizadas pelo menu Configurações (config/listas.json).
listas.json

# Versões antigas guardadas localmente; uma delas tinha chave em texto plano.
_old_/

# Anotações pessoais com caminhos desta máquina (o README cobre o mesmo conteúdo).
cmd.md

# ------------------------------------------------------------------
# Python
# ------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.python_embed/

# ------------------------------------------------------------------
# Editores e sistema
# ------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
